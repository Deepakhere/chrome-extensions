{
  "manifest_version": 3,
  "name": "GhostPilot - AI Web Agent",
  "version": "1.1.0",
  "description": "AI-powered browser automation agent. Press ALT+P to control any web app with natural language.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/ghost-pilot-16.png",
      "32": "icons/ghost-pilot-32.png"
    },
    "default_title": "GhostPilot - AI Agent"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/main.js"],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/ghost-pilot-16.png",
    "32": "icons/ghost-pilot-32.png",
    "48": "icons/ghost-pilot-48.png",
    "128": "icons/ghost-pilot-128.png"
  }
}
